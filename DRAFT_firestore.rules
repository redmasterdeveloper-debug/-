rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all reads and writes unless explicitly matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(category) {
      return category is string && category.size() >= 2 && category.size() <= 60;
    }

    function isValidHolidayType(holidayType) {
      return holidayType is string && holidayType in [
        '',
        'أمطار',
        'مناسبة دينية',
        'مناسبة أخرى',
        'وفاة'
      ];
    }

    function isValidGovernoratesArray(govs) {
      return govs is list
        && govs.size() <= 19
        && (
          govs.size() == 0 ||
          (govs[0] is string && govs[0].size() >= 2 && govs[0].size() <= 40)
        );
    }

    function isValidImageUrl(url) {
      return url is string
        && url.size() <= 350000
        && (
          url == '' ||
          url.matches('^https://.*') ||
          url.matches('^http://.*') ||
          url.matches('^data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function isValidLinkEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['title', 'url'])
        && entry.keys().hasOnly(['title', 'url'])
        && entry.title is string
        && entry.title.size() >= 1
        && entry.title.size() <= 120
        && entry.url is string
        && entry.url.size() >= 8
        && entry.url.size() <= 1000
        && (entry.url.matches('^https://.*') || entry.url.matches('^http://.*'));
    }

    function isValidLinksArray(links) {
      return links is list
        && links.size() <= 10
        && (links.size() == 0 || isValidLinkEntry(links[0]));
    }

    function isValidNewsArticle(data) {
      return data.keys().hasAll([
          'title',
          'category',
          'authorName',
          'content',
          'imageUrl',
          'links',
          'holidayType',
          'holidayOccasion',
          'holidayGovernorates',
          'isPublished',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'title',
          'category',
          'authorName',
          'content',
          'imageUrl',
          'links',
          'holidayType',
          'holidayOccasion',
          'holidayGovernorates',
          'isPublished',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && isValidCategory(data.category)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && data.content is string && data.content.size() >= 10 && data.content.size() <= 15000
        && isValidImageUrl(data.imageUrl)
        && isValidLinksArray(data.links)
        && isValidHolidayType(data.holidayType)
        && data.holidayOccasion is string && data.holidayOccasion.size() <= 120
        && isValidGovernoratesArray(data.holidayGovernorates)
        && data.isPublished is bool
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAdminToken(data) {
      return data.keys().hasAll(['code', 'articleId', 'action', 'createdAt'])
        && data.keys().hasOnly(['code', 'articleId', 'action', 'createdAt'])
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 32
        && isValidId(data.articleId)
        && data.action is string && data.action in ['create', 'delete']
        && data.createdAt is timestamp;
    }

    // Write-only atomic passcode verification tokens (never readable by clients)
    match /admin_tokens/{tokenId} {
      allow read: if false;
      allow create: if isValidId(tokenId)
        && isValidAdminToken(incoming())
        && incoming().code == 'URSKY2027'
        && incoming().createdAt == request.time
        && tokenId == (incoming().action + '_' + incoming().articleId);
      allow update, delete: if false;
    }

    // News articles collection (publicly readable when published, atomic passcode token required for writes/deletes)
    match /news/{articleId} {
      allow get: if isValidId(articleId) && existing().isPublished == true;
      allow list: if existing().isPublished == true;
      allow create: if isValidId(articleId)
        && isValidNewsArticle(incoming())
        && incoming().isPublished == true
        && incoming().createdAt == request.time
        && !('updatedAt' in incoming())
        && getAfter(/databases/$(database)/documents/admin_tokens/$('create_' + articleId)).data.code == 'URSKY2027';
      allow update: if false;
      allow delete: if isValidId(articleId)
        && getAfter(/databases/$(database)/documents/admin_tokens/$('delete_' + articleId)).data.code == 'URSKY2027';
    }
  }
}
